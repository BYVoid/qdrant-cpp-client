load("@grpc//bazel:cc_grpc_library.bzl", "cc_grpc_library")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Bazel build for qdrant-cpp-client. This exposes a small, hand-written
# C++ client for Qdrant's gRPC API as a bzlmod target so downstream
# Bazel projects can depend on it via the Bazel Central Registry.
#
# The .proto files under qdrant/proto/ are vendored verbatim from upstream
# Qdrant (the public, client-facing subset only — cluster-internal service
# protos are not vendored); see qdrant/proto/README.md for the source tag
# and the sync procedure.

package(default_visibility = ["//visibility:public"])

# Message + enum definitions, vendored from upstream. Deps mirror each
# file's import statements.
proto_library(
    name = "qdrant_messages_proto",
    srcs = [
        "qdrant/proto/collections.proto",
        "qdrant/proto/json_with_int.proto",
        "qdrant/proto/points.proto",
        "qdrant/proto/qdrant_common.proto",
    ],
    deps = ["@protobuf//:timestamp_proto"],
)

# Service definitions: Points, Collections, Snapshots, the root Qdrant
# service (HealthCheck), and the standard grpc.health.v1 Health service.
proto_library(
    name = "qdrant_service_proto",
    srcs = [
        "qdrant/proto/collections_service.proto",
        "qdrant/proto/health_check.proto",
        "qdrant/proto/points_service.proto",
        "qdrant/proto/qdrant.proto",
        "qdrant/proto/snapshots_service.proto",
    ],
    deps = [
        ":qdrant_messages_proto",
        "@protobuf//:timestamp_proto",
    ],
)

# C++ message classes for the whole closure (service protos + their imported
# messages protos). One cc_proto_library over the top proto generates code
# for every proto_library it transitively pulls in.
cc_proto_library(
    name = "qdrant_cc_proto",
    deps = [":qdrant_service_proto"],
)

# gRPC service stubs only (grpc_only = True); the message classes and the
# service protos' own *.pb.h come from :qdrant_cc_proto in deps.
cc_grpc_library(
    name = "qdrant_grpc",
    srcs = [":qdrant_service_proto"],
    grpc_only = True,
    deps = [":qdrant_cc_proto"],
)

# The main qdrant-cpp-client library. Downstream callers use
# `#include <qdrant/qdrant_client.h>` and link
# `@qdrant_cpp_client//:qdrant_client`.
cc_library(
    name = "qdrant_client",
    srcs = ["qdrant/qdrant_client.cc"],
    hdrs = ["qdrant/qdrant_client.h"],
    # Expose headers at their workspace path so both internal
    # (`#include "qdrant/qdrant_client.h"`) and external
    # (`#include <qdrant/qdrant_client.h>`) include forms resolve.
    strip_include_prefix = "/",
    deps = [
        ":qdrant_cc_proto",
        ":qdrant_grpc",
        "@grpc//:grpc++",
    ],
)

# Compile-only smoke test: confirms the public header compiles on its own
# (it includes the generated message classes but not the gRPC service
# stubs) and links against the real library.
cc_test(
    name = "qdrant_client_compile_test",
    size = "small",
    srcs = ["qdrant/qdrant_client_compile_test.cc"],
    deps = [":qdrant_client"],
)
